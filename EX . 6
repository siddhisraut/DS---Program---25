#include <iostream>
using namespace std;

int main() {
    cout << "Name   : Siddhi Sachin Raut\n";
    cout << "Roll No: 25\n";
    cout << "Class  : S.Y. B. CSE\n";

    int n;
    cout << "\nEnter size of queue: ";
    cin >> n;

    int *queueArr = new int[n];
    int front = -1, rear = -1;
    int choice, value;

    do {
        cout << "\n----- QUEUE MENU -----\n";
        cout << "1. Insert\n";
        cout << "2. Delete\n";
        cout << "3. Display\n";
        cout << "4. Exit\n";
        cout << "Enter your choice: ";
        cin >> choice;

        switch(choice) {
            case 1:   
                if (rear == n - 1) {
                    cout << "Queue Overflow\n";
                } else {
                    cout << "Enter element: ";
                    cin >> value;

                    if (front == -1) 
                        front = 0;

                    rear++;
                    queueArr[rear] = value;
                    cout << "Element Inserted\n";
                }
                break;

            case 2:   
                if (front == -1) {
                    cout << "Queue Underflow\n";
                } else {
                    cout << "Deleted element: " << queueArr[front] << endl;
                    front++;

                    if (front > rear) { // Reset if queue becomes empty
                        front = rear = -1;
                    }
                }
                break;

            case 3:   
                if (front == -1) {
                    cout << "Queue is Empty\n";
                } else {
                    cout << "Queue elements: ";
                    for (int i = front; i <= rear; i++) {
                        cout << queueArr[i] << " ";
                    }
                    cout << endl;
                }
                break;

            case 4:   
                cout << "Exiting Program...\n";
                break;

            default:
                cout << "Invalid Choice\n";
        }

    } while(choice != 4);

    delete[] queueArr; 
    return 0;
}
